# 이 파일을 복사해서 .env.local 로 이름을 바꾼 뒤 값을 채워주세요.

# 사이트 주소 (카카오톡 공유 미리보기 이미지 주소에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 카카오 지도 JavaScript 키 (https://developers.kakao.com → 내 애플리케이션 → 앱 키)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 네이버 지도 Client ID (https://console.ncloud.com → Maps → Application)
# 카카오 키가 없을 때만 네이버 지도가 사용돼요.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
