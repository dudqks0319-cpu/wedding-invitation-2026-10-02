# local: 브라우저 전용 미리보기 / remote: Next 서버 + Supabase
# NEXT_PUBLIC_* 값은 빌드 시 고정됩니다. 변경 후 다시 빌드하세요.
NEXT_PUBLIC_DATA_MODE=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_KAKAO_MAP_KEY=
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NEXT_PUBLIC_KAKAO_JS_KEY=

# 서버 전용. NEXT_PUBLIC 접두사를 붙이지 마세요.
BACKEND_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# openssl rand -hex 32 로 새로 생성
ABUSE_HASH_SECRET=
# 배포 경계가 직접 덮어쓰는 헤더만 선택: x-vercel-forwarded-for 또는 cf-connecting-ip.
# 직접 원본 서버로 접근 가능하면 설정하지 마세요. 비워 두면 하객이 보수적인 공통 한도를 사용합니다.
TRUSTED_PROXY_HEADER=
# 로컬 HTTP Supabase 테스트에서만 true. 운영 환경에서는 비워 두세요.
ALLOW_LOCAL_SUPABASE=
