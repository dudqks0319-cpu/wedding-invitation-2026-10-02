/dist-preview
/dist/
/.sites-runtime/
/supabase/.temp/
/docs/evidence/site.tar.gz
/docs/evidence/site-workflow.log

# 코덱스 작업 기록
/.codex-logs

# 로컬에서 읽은 공식 문서 원문 (변경 소스가 아님)
